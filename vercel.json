{
    "version": 2,
    "builds": [
        {
            "src": "app.py",
            "use": "@vercel/python"
        },
        {
            "src": "frontend/package.json",
            "use": "@vercel/static-build",
            "config": { "distDir": "dist" }
        }
    ],
    "routes": [
        { "src": "/api/(.*)", "dest": "app.py" },
        { "src": "/exports/(.*)", "dest": "app.py" },
        { "src": "/generate-report", "dest": "app.py" },
        { "src": "/test-flow", "dest": "app.py" },
        { "src": "/health", "dest": "app.py" },
        { "src": "/assets/(.*)", "dest": "/assets/$1" },
        { "handle": "filesystem" },
        { "src": "/(.*)", "dest": "/index.html" }
    ]
}
