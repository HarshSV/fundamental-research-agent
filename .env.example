# ============================================================================
# Navrist Research Terminal — environment template
# Copy this file to ".env" and fill in real values. NEVER commit the real .env.
# ============================================================================

# --- Angel One SmartAPI (live prices / F-01 market data) --------------------
# Get these from https://smartapi.angelbroking.com (My Profile -> Create App).
# ANGEL_TOTP_SECRET is the base32 seed shown when you enable TOTP / scan the QR
# in an authenticator app — NOT the 6-digit code. Leave blank to run on the
# yfinance fallback (~15 min delayed).
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=

# --- Groq Cloud (qualitative AI analysis: F-07/F-14/F-15/F-16/F-20) ---------
# Free key from https://console.groq.com/keys
GROQ_API_KEY=

# --- Apify (Screener.in structured data: financials, ratios, shareholding) ---
# Free account at https://console.apify.com → Settings → Integrations → API Token
# Free tier gives $5/month (~500 stock lookups). Data is cached 12h locally.
APIFY_API_TOKEN=

# --- Site authentication ----------------------------------------------------
# Single shared password users type to enter the terminal.
SITE_PASSWORD=change-me
# Secret used to sign login tokens. Generate a long random string.
# Rotating it logs everyone out. e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
# How long a login stays valid before re-authentication (hours).
ACCESS_TOKEN_EXPIRE_HOURS=12

# --- Server (production) ----------------------------------------------------
# HOST=0.0.0.0 makes the server reachable on a cloud box. PORT is the listen
# port (many platforms inject this). RELOAD=0 disables dev auto-reload in prod.
HOST=0.0.0.0
PORT=8000
RELOAD=0

# --- NSE scraping ----------------------------------------------------------
# Leave this UNSET in production. Only set NSE_INSECURE=1 on a local machine
# whose certificate store can't verify NSE's TLS (dev convenience only).
# NSE_INSECURE=1
